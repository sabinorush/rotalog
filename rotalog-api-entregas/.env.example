# RotaLog - API Entregas Environment Variables
# Copie este arquivo para .env e preencha com valores reais.
# NUNCA versione o .env preenchido (segredos reais).

NODE_ENV=development
PORT=3000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rotalog
DB_USER=rotalog_admin
DB_PASSWORD=
DB_SCHEMA=entregas

# Auth
# Segredo usado para assinar/verificar tokens JWT (jsonwebtoken).
# Obrigatório - não há fallback hardcoded no código.
JWT_SECRET=

# External Services
API_FROTAS_URL=http://localhost:8080/api
API_NOTIFICACOES_URL=http://localhost:5000

# Feature Flags
ENABLE_TRACKING=true
ENABLE_NOTIFICATIONS=true
ENABLE_CACHE=false
